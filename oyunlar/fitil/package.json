{
  "name": "fitil",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "build:single": "vite build --mode single && node scripts/bundle-single.mjs",
    "build:android": "vite build --mode android && cap sync android",
    "android:ac": "cap open android",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "bot": "tsx src/bot/sim-cli.ts",
    "dogrula": "tsx src/bot/sim-cli.ts --dogrula",
    "kalibre": "tsx src/bot/sim-cli.ts --kalibre",
    "shot": "node scripts/shot.mjs",
    "oynanis": "node scripts/oynanis.mjs"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@types/node": "^22.20.5",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.2"
  },
  "config": {
    "slug": "fitil"
  },
  "description": "FİTİL — aynı renkleri fitille bağla, ısıyı biriktir, zincirleme havai fişek şovu yap. Eşleştirmeli bulmaca oyunu.",
  "dependencies": {
    "@capacitor-community/admob": "8.2.1",
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capgo/native-purchases": "8.9.2",
    "@fontsource-variable/nunito": "5.3.0"
  }
}
